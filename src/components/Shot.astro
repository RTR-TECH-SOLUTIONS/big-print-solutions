---
// O poză de lucrare cu legendă de catalog: client + ce s-a executat.
import { workByFile } from '../data/lucrari';
import { u } from '../data/site';

interface Props {
  file: string;
  eager?: boolean;
  ratio?: string;
  caption?: boolean;
}
const { file, eager = false, ratio, caption = true } = Astro.props;
const work = workByFile(file);
---
<figure class="shot">
  <div class="frame">
  <img
    src={u(`/lucrari/${work.file}.webp`)}
    alt={`${work.what}, ${work.client}`}
    width={work.w}
    height={work.h}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={ratio ? `aspect-ratio:${ratio}` : undefined}
  />
  </div>
  {caption && (
    <figcaption>
      <strong>{work.client}</strong>
      <span>{work.what}</span>
    </figcaption>
  )}
</figure>

<style>
  .shot { margin: 0; }
  .frame { overflow: hidden; border-radius: var(--radius-card); background: var(--color-stock); }
  img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .shot:hover img { transform: scale(1.04); }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.6rem;
    margin-top: 0.6rem;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  figcaption strong { font-weight: 700; }
  figcaption span { color: var(--color-ink-soft); }
</style>
