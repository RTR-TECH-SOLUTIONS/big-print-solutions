---
// Bandă de lucrări: curge singură, dar se poate derula cu degetul, cu trackpad-ul,
// trasă cu mouse-ul, din săgeți sau din tastatură.
import { workByFile } from '../data/lucrari';
import { u } from '../data/site';

interface Props {
  files: string[];
}
const { files } = Astro.props;
const items = files.map(workByFile);
---
<div class="strip-wrap" data-strip>
  <div class="strip" data-strip-scroller tabindex="0" role="region" aria-label="Lucrări executate, bandă derulantă">
    <ul class="track">
      {[0, 1].map((copy) =>
        items.map((w) => (
          <li aria-hidden={copy === 1 ? 'true' : undefined} data-copy={copy}>
            <figure>
              <img
                src={u(`/lucrari/${w.file}.webp`)}
                alt={copy === 0 ? `${w.what}, ${w.client}` : ''}
                width={w.w}
                height={w.h}
                loading="eager"
                decoding="async"
                draggable="false"
              />
              <figcaption><strong>{w.client}</strong> {w.what}</figcaption>
            </figure>
          </li>
        ))
      )}
    </ul>
  </div>

  <button type="button" class="arrow arrow-prev" data-strip-prev aria-label="Lucrările anterioare">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <button type="button" class="arrow arrow-next" data-strip-next aria-label="Lucrările următoare">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((root) => {
    const scroller = root.querySelector<HTMLElement>('[data-strip-scroller]')!;
    const track = scroller.querySelector<HTMLElement>('.track')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const gap = parseFloat(getComputedStyle(track).columnGap) || 0;

    // Conținutul e dublat; după o jumătate de bandă sărim înapoi, ca derularea să nu se termine.
    const half = () => (track.scrollWidth + gap) / 2;
    let pos = 1;
    let pausedUntil = 0;
    let hovering = false;
    let dragging = false;

    const wrap = () => {
      if (reduced) return;
      const h = half();
      if (scroller.scrollLeft >= h) scroller.scrollLeft -= h;
      else if (scroller.scrollLeft <= 0) scroller.scrollLeft += h;
      // sincronizăm doar la salturi reale; altfel rotunjirea browserului ar bloca pașii mici
      if (Math.abs(scroller.scrollLeft - pos) > 1.5) pos = scroller.scrollLeft;
    };
    const hold = (ms = 3500) => { pausedUntil = performance.now() + ms; };

    if (!reduced) scroller.scrollLeft = pos;
    scroller.addEventListener('scroll', wrap, { passive: true });

    // Curgerea automată
    let last = performance.now();
    const tick = (now: number) => {
      const dt = Math.min(now - last, 50);
      last = now;
      if (!hovering && !dragging && now > pausedUntil && !document.hidden) {
        pos += dt * 0.035;
        scroller.scrollLeft = pos;
      }
      requestAnimationFrame(tick);
    };
    if (!reduced) requestAnimationFrame(tick);

    root.addEventListener('mouseenter', () => { hovering = true; });
    root.addEventListener('mouseleave', () => { hovering = false; });
    scroller.addEventListener('touchstart', () => hold(), { passive: true });
    scroller.addEventListener('touchmove', () => hold(), { passive: true });
    scroller.addEventListener('wheel', () => hold(), { passive: true });
    scroller.addEventListener('keydown', () => hold());
    root.addEventListener('focusin', () => hold(8000));

    // Tragere cu mouse-ul
    let startX = 0;
    let startLeft = 0;
    let moved = false;
    scroller.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      moved = false;
      startX = e.clientX;
      startLeft = scroller.scrollLeft;
      scroller.setPointerCapture(e.pointerId);
      scroller.classList.add('dragging');
    });
    scroller.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;
      let next = startLeft - dx;
      if (!reduced) {
        const h = half();
        next = ((next % h) + h) % h || 1;
      }
      scroller.scrollLeft = next;
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      scroller.classList.remove('dragging');
      hold();
    };
    scroller.addEventListener('pointerup', endDrag);
    scroller.addEventListener('pointercancel', endDrag);

    // Săgeți: derulare animată pas cu pas, ca să treacă lin peste punctul de reluare
    const glide = (distance: number) => {
      hold(6000);
      if (reduced) { scroller.scrollBy({ left: distance }); return; }
      const duration = 450;
      const t0 = performance.now();
      let done = 0;
      const step = (now: number) => {
        const t = Math.min((now - t0) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        const target = distance * eased;
        scroller.scrollLeft += target - done;
        done = target;
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const page = () => Math.max(280, scroller.clientWidth * 0.7);
    root.querySelector('[data-strip-prev]')!.addEventListener('click', () => glide(-page()));
    root.querySelector('[data-strip-next]')!.addEventListener('click', () => glide(page()));
  });
</script>

<style>
  .strip-wrap {
    --h: clamp(11rem, 26vw, 21rem);
    position: relative;
  }
  .strip {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    user-select: none;
  }
  .strip::-webkit-scrollbar { display: none; }
  .strip.dragging { cursor: grabbing; }
  .strip:focus-visible { outline: 3px solid var(--color-yellow); outline-offset: -3px; }
  .track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
  }
  li { flex: none; }
  figure { margin: 0; }
  img {
    display: block;
    height: var(--h);
    width: auto;
    border-radius: var(--radius-card);
    pointer-events: none;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: #a9a69e;
    max-width: 22rem;
  }
  figcaption strong { color: #fff; font-weight: 700; margin-right: 0.35rem; }

  .arrow {
    position: absolute;
    top: calc(var(--h) / 2);
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-yellow);
    color: var(--color-ink);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.3), 0 8px 20px rgb(0 0 0 / 0.3);
    cursor: pointer;
    transition: background-color 180ms ease-out, transform 180ms ease-out;
  }
  .arrow:hover { background: #fff; }
  .arrow:active { transform: translateY(-50%) scale(0.94); }
  .arrow:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .arrow-prev { left: 0.75rem; }
  .arrow-next { right: 0.75rem; }

  @media (max-width: 640px) {
    .arrow { width: 2.75rem; height: 2.75rem; }
    .arrow-prev { left: 0.5rem; }
    .arrow-next { right: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    li[data-copy='1'] { display: none; }
  }
</style>
