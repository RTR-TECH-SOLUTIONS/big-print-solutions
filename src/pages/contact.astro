---
import Layout from '../layouts/Layout.astro';
import IconWhatsapp from '../components/IconWhatsapp.astro';
import { site } from '../data/site';
import { priceGroups } from '../data/preturi';

const topics = [...priceGroups.filter((g) => g.id !== 'finisaje').map((g) => g.title), 'Altceva'];
---
<Layout title="Contact | Big Print Solutions, Râmnicu Vâlcea">
  <section class="head">
    <div class="wrap contact-in">
      <div>
        <h1>Contact</h1>
        <p class="lead">Atelierul este pe {site.address}. Sunați înainte dacă veniți cu o lucrare mare.</p>

        <dl class="nap">
          <div><dt>Mobil</dt><dd><a href={site.phoneHref} class="num">{site.phone}</a><br /><a href={site.phone2Href} class="num">{site.phone2}</a></dd></div>
          <div><dt>Fix / Fax</dt><dd class="num"><a href={site.landlineHref}>{site.landline}</a><br />Fax {site.fax}</dd></div>
          <div><dt>E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>Program</dt><dd>{site.hours}</dd></div>
          <div><dt>Firma</dt><dd>{site.legalName} ({site.brand})<br /><span class="num">CUI {site.cui} · {site.regCom}</span></dd></div>
          <div><dt>Cont</dt><dd><span class="num">{site.iban}</span><br />{site.bank}</dd></div>
        </dl>
      </div>

      <form class="form" data-wa-form data-wa={site.whatsapp} novalidate>
        <h2>Cerere de ofertă</h2>
        <p class="form-note">Formularul deschide WhatsApp cu mesajul gata scris. Poza locului de montaj o atașați acolo.</p>

        <label for="f-name">Nume</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required />

        <label for="f-topic">Ce vă trebuie</label>
        <select id="f-topic" name="topic">
          {topics.map((t) => <option>{t}</option>)}
        </select>

        <label for="f-msg">Detalii: dimensiuni, cantitate, termen</label>
        <textarea id="f-msg" name="msg" rows="4" required></textarea>

        <p class="form-error" role="alert" hidden data-error>Completați numele și detaliile lucrării.</p>
        <button type="submit" class="btn btn-yellow"><IconWhatsapp /> Trimite pe WhatsApp</button>
      </form>
    </div>
  </section>

  <section class="map">
    <iframe
      src={site.mapEmbed}
      title={`Hartă: ${site.address}`}
      width="1200"
      height="420"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-wa-form]');
  if (form) {
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const msg = String(data.get('msg') ?? '').trim();
      if (!name || !msg) {
        error.hidden = false;
        return;
      }
      error.hidden = true;
      // TODO(real): pe lângă WhatsApp, cererea se poate trimite și pe e-mail (Resend).
      const text = `Bună ziua! Sunt ${name}.\nCerere: ${data.get('topic')}\n${msg}`;
      window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
  }
</script>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .contact-in { display: grid; gap: 3rem; align-items: start; }
  .lead { margin-top: 1rem; max-width: 30rem; }

  .nap { margin-top: 2.5rem; border-top: 3px solid var(--color-ink); }
  .nap > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .nap dt { color: var(--color-ink-soft); font-size: 0.92rem; }
  .nap dd { font-weight: 600; }
  .nap a { text-decoration: none; }
  .nap a:hover { text-decoration: underline; }

  .form {
    background: var(--color-stock);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    gap: 0.4rem;
  }
  .form h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .form-note { color: var(--color-ink-soft); font-size: 0.92rem; margin-bottom: 0.75rem; }
  label { font-weight: 700; font-size: 0.95rem; margin-top: 0.6rem; }
  input, select, textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.8rem;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-btn);
    background: #fff;
    font: inherit;
  }
  textarea { resize: vertical; }
  .form .btn { margin-top: 1.25rem; }
  .form-error { color: #a4161a; font-weight: 600; font-size: 0.95rem; margin-top: 0.5rem; }

  .map iframe { display: block; width: 100%; height: clamp(18rem, 40vw, 26rem); border: 0; filter: grayscale(1) contrast(1.05); }

  @media (min-width: 900px) {
    .contact-in { grid-template-columns: 1fr 1fr; gap: 5rem; }
  }
</style>
