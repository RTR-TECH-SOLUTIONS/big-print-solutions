---
import Layout from '../layouts/Layout.astro';
import PriceTable from '../components/PriceTable.astro';
import CtaBand from '../components/CtaBand.astro';
import IconWhatsapp from '../components/IconWhatsapp.astro';
import { priceGroups, groupById } from '../data/preturi';
import { site } from '../data/site';

const calcRows = groupById('print').rows.filter((r) => r.calc);
const fin = Object.fromEntries(groupById('finisaje').rows.map((r) => [r.id, r.price]));
---
<Layout
  title="Prețuri print și producție publicitară | Big Print Solutions"
  description="Lista de prețuri pentru print format mare, litere volumetrice, firme luminoase și colantări auto, cu calculator pe metru pătrat."
>
  <section class="head">
    <div class="wrap">
      <h1>Prețuri</h1>
      <p class="lead">Tarifele de pornire pentru lucrările pe care le facem cel mai des. Pentru o cifră exactă, trimiteți dimensiunile.</p>
      <nav class="jump" aria-label="Sari la categorie">
        <a href="#calculator">Calculator</a>
        {priceGroups.map((g) => <a href={`#tarif-${g.id}`}>{g.title}</a>)}
      </nav>
    </div>
  </section>

  <section class="calc-sec" id="calculator">
    <div class="wrap">
      <form class="calc" data-calc data-wa={site.whatsapp} data-capse={fin['capse']} data-laminare={fin['laminare']} data-aplicare={fin['aplicare']}>
        <div class="calc-fields">
          <h2>Calculator de print</h2>

          <label for="c-mat">Material</label>
          <select id="c-mat" name="mat">
            {calcRows.map((r) => <option value={r.price} data-name={r.name}>{r.name}, {r.price} lei/mp</option>)}
          </select>

          <div class="calc-row">
            <div>
              <label for="c-w">Lățime (cm)</label>
              <input id="c-w" name="w" type="number" inputmode="numeric" min="10" max="5000" step="1" value="300" />
            </div>
            <div>
              <label for="c-h">Înălțime (cm)</label>
              <input id="c-h" name="h" type="number" inputmode="numeric" min="10" max="5000" step="1" value="100" />
            </div>
            <div>
              <label for="c-q">Bucăți</label>
              <input id="c-q" name="q" type="number" inputmode="numeric" min="1" max="500" step="1" value="1" />
            </div>
          </div>

          <fieldset>
            <legend>Finisaje</legend>
            <label class="check"><input type="checkbox" name="capse" checked /> Tiv și capse ({fin['capse']} lei/ml)</label>
            <label class="check"><input type="checkbox" name="laminare" /> Laminare ({fin['laminare']} lei/mp)</label>
            <label class="check"><input type="checkbox" name="aplicare" /> Aplicare / montaj ({fin['aplicare']} lei/mp)</label>
          </fieldset>
        </div>

        <div class="calc-out" aria-live="polite">
          <p class="out-label">Preț estimat, fără TVA</p>
          <p class="out-total num"><span data-total>0</span> lei</p>
          <dl>
            <div><dt>Suprafață</dt><dd class="num"><span data-area>0</span> mp</dd></div>
            <div><dt>Print</dt><dd class="num"><span data-print>0</span> lei</dd></div>
            <div><dt>Finisaje</dt><dd class="num"><span data-fin>0</span> lei</dd></div>
          </dl>
          <button type="submit" class="btn btn-yellow"><IconWhatsapp /> Trimite calculul pe WhatsApp</button>
          <p class="out-note">Estimare orientativă. Sub 1 mp se taxează 1 mp.</p>
        </div>
      </form>
    </div>
  </section>

  <section class="tables">
    <div class="wrap tables-in">
      {priceGroups.map((g) => <PriceTable group={g.id} heading />)}
    </div>
  </section>

  <CtaBand
    title="Nu găsiți lucrarea în listă?"
    text="Facem și materiale electorale, pardoseli epoxidice printate, amenajări și decoruri. Spuneți-ne ce vă trebuie."
  />
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-calc]');
  if (form) {
    const ro = (n: number, digits = 0) =>
      n.toLocaleString('ro-RO', { minimumFractionDigits: digits, maximumFractionDigits: digits });
    const out = (key: string) => form.querySelector<HTMLElement>(`[data-${key}]`)!;
    const rate = (key: string) => Number(form.dataset[key]);
    const num = (name: string, fallback: number) => {
      const v = Number((form.elements.namedItem(name) as HTMLInputElement).value);
      return Number.isFinite(v) && v > 0 ? v : fallback;
    };
    const checked = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).checked;

    const compute = () => {
      const mat = form.elements.namedItem('mat') as HTMLSelectElement;
      const w = num('w', 0) / 100;
      const h = num('h', 0) / 100;
      const q = Math.max(1, Math.round(num('q', 1)));
      const area = w * h * q;
      const billed = area > 0 ? Math.max(1, area) : 0;
      const print = billed * Number(mat.value);
      let fin = 0;
      if (checked('capse')) fin += 2 * (w + h) * q * rate('capse');
      if (checked('laminare')) fin += billed * rate('laminare');
      if (checked('aplicare')) fin += billed * rate('aplicare');
      return { name: mat.selectedOptions[0].dataset.name, w: w * 100, h: h * 100, q, area, print, fin, total: print + fin };
    };

    const render = () => {
      const r = compute();
      out('area').textContent = ro(r.area, 2);
      out('print').textContent = ro(Math.round(r.print));
      out('fin').textContent = ro(Math.round(r.fin));
      out('total').textContent = ro(Math.round(r.total));
    };

    form.addEventListener('input', render);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const r = compute();
      const extras = ['capse', 'laminare', 'aplicare'].filter(checked).join(', ') || 'fără';
      const text =
        `Bună ziua! Aș dori o ofertă:\n${r.name}, ${r.w} x ${r.h} cm, ${r.q} buc (${ro(r.area, 2)} mp)\n` +
        `Finisaje: ${extras}\nEstimare din calculator: ${ro(Math.round(r.total))} lei fără TVA`;
      window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
    render();
  }
</script>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem; }
  .lead { margin-top: 1rem; max-width: 38rem; }
  .jump { margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .jump a {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-yellow);
  }
  .jump a:hover { text-decoration-color: var(--color-ink); }

  .calc {
    display: grid;
    border: 3px solid var(--color-ink);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .calc-fields { padding: clamp(1.5rem, 4vw, 2.5rem); display: grid; gap: 0.4rem; align-content: start; }
  .calc-fields h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 0.5rem; }
  label, legend { font-weight: 700; font-size: 0.95rem; margin-top: 0.6rem; }
  .calc-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .calc-row > div { display: grid; gap: 0.4rem; }
  input[type='number'], select {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.8rem;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-btn);
    background: #fff;
    font: inherit;
    font-variant-numeric: tabular-nums;
  }
  fieldset { margin-top: 0.6rem; display: grid; gap: 0.15rem; }
  .check {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 500;
    min-height: 2.5rem;
    margin: 0;
    cursor: pointer;
  }
  .check input { width: 1.25rem; height: 1.25rem; accent-color: var(--color-ink); }

  .calc-out {
    background: var(--color-ink);
    color: #fff;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }
  .out-label { color: var(--color-mist); font-size: 0.95rem; }
  .out-total {
    font-weight: 800;
    font-stretch: 88%;
    font-size: clamp(2.75rem, 7vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-yellow);
  }
  .calc-out dl { margin-block: 1rem; border-top: 1px solid #3a3936; }
  .calc-out dl > div {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0;
    border-bottom: 1px solid #3a3936;
  }
  .calc-out dt { color: #cfccc4; }
  .calc-out dd { font-weight: 700; }
  .out-note { color: var(--color-mist); font-size: 0.85rem; margin-top: 0.5rem; }

  .tables { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .tables-in { display: grid; gap: clamp(3rem, 6vw, 4.5rem); }

  @media (min-width: 900px) {
    .calc { grid-template-columns: 1.35fr 1fr; }
  }
  @media (max-width: 420px) {
    .calc-row { grid-template-columns: 1fr 1fr; }
  }
</style>
